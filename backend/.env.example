# ScamShield Backend Configuration
# Copy this file to .env and fill in real values.
# Never commit real secrets to version control.

# Application
APP_NAME=scamshield
APP_ENV=development
DEBUG=true
API_V1_STR=/api

# Database (SQLite by default; set DATABASE_URL for PostgreSQL migration)
DATABASE_URL=sqlite:///./scamshield.db

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (frontend origin)
BACKEND_CORS_ORIGINS=http://localhost:5173

# OpenAI (optional - for AI investigation explanations & reports)
OPENAI_API_KEY=

# Google Safe Browsing (optional - URL reputation)
GOOGLE_SAFE_BROWSING_API_KEY=

# URLhaus (optional - URL reputation)
URLHAUS_API_KEY=